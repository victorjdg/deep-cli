# DeepSeek API key (required)
# Get yours at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Model to use (default: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# Maximum context window size in tokens (default: auto-detected from model)
# DEEPSEEK_MAX_CONTEXT=128000

# Maximum number of parallel subagents for delegate_task (default: 5)
# DEEPSEEK_MAX_SUBAGENTS=5

# Web search — configure one of the following engines:

# Tavily (https://tavily.com)
# TAVILY_API_KEY=

# Brave Search (https://api.search.brave.com)
# BRAVE_SEARCH_API_KEY=

# SearXNG (self-hosted)
# SEARXNG_HOST=http://localhost:8080
